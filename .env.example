# Organization's GitLab token (project access token, role Owner or Maintainer, scopes api + write_repository).
# It is stored by the administrator in the portal (Administration > Shared accesses > GitLab), never in a terminal.
GITLAB_PAT=
# HTTPS address of the demo repository, without credentials (https://gitlab.com/<group>/<project>.git)
GITLAB_GIT=
# YOUR personal Open WebUI API key (Settings > Account > API keys > Create new secret key), for opencode through
# Open WebUI. Each user saves their own key in the portal as a personal token (PAT) named "openwebui", host
# open-webui.terminals.svc.cluster.local: the terminal only sees the placeholder in $PAT_OPENWEBUI. Never put it in
# a terminal or in a file of the sandbox.
PAT_OPENWEBUI=
