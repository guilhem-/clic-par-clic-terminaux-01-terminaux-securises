# Organization's GitLab token (project access token, role Owner or Maintainer, scopes api + write_repository).
# It is stored by the administrator in the portal (Administration > Shared accesses > GitLab), never in a terminal.
GITLAB_PAT=
# HTTPS address of the demo repository, without credentials (https://gitlab.com/<group>/<project>.git)
GITLAB_GIT=
# API key of the Open WebUI service account "Terminals (agents)" (role user, never admin), for the "openwebui" shared
# access. Created in Open WebUI (Settings > Account > API keys) while signed in as that account; stored by the
# administrator in the portal (Administration > Shared accesses > Models (Open WebUI)), never in a terminal.
OPENWEBUI_API_KEY=
